{
  "name": "jayra",
  "productName": "JAYRA",
  "description": "JAYRA — a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "JAYRA",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:cognition": "node --import tsx --test cognition/tests/*.test.ts",
    "test:permissions": "node --import tsx --test permissions/controller.test.ts",
    "test:settings": "node --import tsx --test settings/appSettings.test.ts",
    "test:persona": "node --import tsx --test agent/persona.test.ts",
    "test:automation": "node --import tsx --test runtime/customAutomation.test.ts companion/wellness.test.ts",
    "test:screen-vision": "node --import tsx --test server_screenVision.test.ts",
    "test:real-browser": "node --import tsx --test server_realBrowser.test.ts",
    "test:api-hub": "node --import tsx --test api_hub/tests/*.test.ts",
    "test:custom-assets": "node --import tsx --test runtime/customAssets.test.ts",
    "test:games": "node --import tsx --test runtime/ticTacToe.test.ts",
    "test:gestures": "node --import tsx --test src/lib/gestureMath.test.ts",
    "test:python": "python -m unittest discover -s desktop_agent -p \"test_*.py\"",
    "simulate:cognition": "tsx scripts/simulate-cognition.ts",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist": "npm run build && npm run build:launcher && electron-builder --win nsis portable",
    "dist:public": "set VITE_JAYRA_PUBLIC=1&& npm run build && npm run build:launcher && electron-builder --config electron-builder.public.yml --win nsis portable",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "test:characters": "node --import tsx --test tests/characters.test.ts",
    "test:character-animation": "node --import tsx --test src/tests/characterAnimation.test.ts",
    "test:voice": "node --import tsx --test tests/voice.test.ts",
    "test:mobile": "node --import tsx --test mobile/lanDiscovery.test.ts tests/phoneBridge.test.ts",
    "test:shadow": "node --import tsx --test tests/predictiveShadowExecution.test.ts",
    "test:spatial": "node --import tsx --test tests/spatialProximity.test.ts",
    "test:vibe": "node --import tsx --test tests/vibeShifting.test.ts",
    "test:kg": "node --import tsx --test tests/knowledgeGraph.test.ts",
    "test:mic-gating": "node --import tsx --test tests/micGating.test.ts",
    "test:notifications": "node --import tsx --test tests/notifications.test.ts",
    "test:avatar-audio-sync": "node --import tsx --test src/tests/avatarAudioSync.test.ts",
    "test:agent": "node --import tsx --test tests/core.test.ts tests/models.test.ts tests/agentLoop.test.ts tests/presence.test.ts tests/chatOpen.test.ts tests/reactEngine.test.ts tests/workspaceBriefing.test.ts runtime/workspace.test.ts",
    "test": "npm run lint && npm run test:agent && npm run test:cognition && npm run test:permissions && npm run test:settings && npm run test:persona && npm run test:automation && npm run test:custom-assets && npm run test:games && npm run test:gestures && npm run test:characters && npm run test:character-animation && npm run test:voice && npm run test:mobile && npm run test:avatar-audio-sync && npm run test:python",
    "import:character": "tsx tools/import-character.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "koffi": "^2.16.3",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
